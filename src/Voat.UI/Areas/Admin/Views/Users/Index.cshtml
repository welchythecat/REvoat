@model Voat.UI.Areas.Admin.Models.UserLookupViewModel

@{
    ViewBag.Title = "User Lookup";
}

<div id="container">
    <div class="side">
        @Html.Partial("~/Areas/Admin/Views/Shared/_AdminSidebar.cshtml")
    </div>
    <div class="content" role="main">
        <div class="row nomargin">
            <div class="well col-md-12">
                <div class="alert-title">User Lookup</div>

                @* GET, so no anti-forgery token: searching must be bookmarkable
                    and must not mutate anything. *@
                @using (Html.BeginForm("Index", "Users", new { area = "Admin" }, FormMethod.Get, null, new { @class = "form-horizontal", role = "form" }))
                {
                    <div class="form-group">
                        <label for="q" class="col-md-4 control-label">Username</label>
                        <div class="col-md-6">
                            <input type="text" id="q" name="q" class="form-control" value="@Model.Term"
                                   placeholder="Starts with…" autocomplete="off" />
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-md-offset-4 col-md-3">
                            <input type="submit" value="Search" class="btn-whoaverse" />
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (Model.Users != null)
        {
            <div class="row nomargin">
                <div class="well col-md-12">
                    <div class="alert-title">Results</div>
                    @if (System.Linq.Enumerable.Any(Model.Users))
                    {
                        <table class="table table-striped table-condensed">
                            <thead>
                                <tr>
                                    <th>Username</th>
                                    <th>Registered</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in Model.Users)
                                {
                                    <tr>
                                        <td>
                                            @Html.ActionLink(user.UserName, "Detail", "Users",
                                                new { area = "Admin", name = user.UserName }, null)
                                        </td>
                                        <td>
                                            <time title="@user.RegistrationDateTime" datetime="@user.RegistrationDateTime">
                                                @user.RegistrationDateTime
                                            </time>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <p>Prefix search — a term of at least a few characters works best.</p>
                    }
                    else
                    {
                        <p>No users match “@Model.Term”.</p>
                    }
                </div>
            </div>
        }
    </div>
</div>
